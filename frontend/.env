# ReGo Frontend Environment Variables
# Copy this file to .env.local for local overrides

# API Configuration
# Set to 'true' to use mock API, 'false' to connect to real backend
REACT_APP_ENABLE_MOCK_API=true

# Backend API Base URL (only used when mock API is disabled)
REACT_APP_API_BASE_URL=https://localhost:7133

# Environment
REACT_APP_ENV=development

# Add other environment variables as needed
